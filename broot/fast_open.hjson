verbs: [
    {
        invocation: edit_in_git_root
        key: alt-enter
        apply_to: file
        from_shell: true
        leave_broot: true
        execution: "niri msg action spawn-sh -- \"footclient fish -C \\\"cd '{git-root}' && direnv exec . nvim '{file}'\\\"\""
    }

    {
        invocation: copy_file
        leave_broot: true
        from_shell: true
        execution: "cat {file} | wl-copy"
    }

    {
        invocation: drag
        leave_broot: true
        from_shell: true
        execution: "dragon-drop {file}"
    }

    {
        invocation: open_doc
        key: enter
        extensions: ["pdf", "fb2", "djvu", "cbz"]
        from_shell: true
        execution: "nohup zathura {file} >/dev/null 2>&1 &" 
        leave_broot: true
    }

    {
        invocation: open_img
        key: enter
        extensions: ["png", "jpg", "jpeg"]
        from_shell: true
        execution: "nohup vimiv {file} >/dev/null 2>&1 &" 
        leave_broot: true
    }
    {
        invocation: open_video
        key: enter
        extensions: ["mkv", "mp4", "avi", "webm", "mp3"]
        execution: "niri msg action spawn-sh -- 'mpv {file}'"
        leave_broot: true
        from_shell: true
    }

    {
        invocation: edit
        key: enter
        apply_to: text_file
        execution: "niri msg action spawn-sh -- \"footclient nvim +{line} '{file}'\""
        leave_broot: true
    }

    {
        key: ctrl-u
        internal: ":input_clear"
    }

    {
        key: ctrl-h
        internal: ":input_del_char_left"
    }

    {
        key: ctrl-w
        internal: ":input_del_word_left"
    }
    {
        invocation: terminal
        key: enter
        execution: "niri msg action spawn-sh -- \"footclient -D {directory}\""
        set_working_dir: true
        leave_broot: true
    }

    {
        invocation: git_diff
        key: alt-d
        apply_to: text_file
        from_shell: true
        leave_broot: true
        execution: "git diff {file} | delta"
    }

    {
        invocation: home
        key: ctrl-home
        execution: ":focus ~"
    }

    {
        invocation: gtr
        execution: ":focus {git-root}"
    }

    {
        key: ctrl-k
        execution: ":line_up"
    }
    {
        key: ctrl-j
        execution: ":line_down"
    }
    {
        invocation: "copy_path"
        execution: "echo -n {file-git-relative} | wl-copy"
        leave_broot: true
        from_shell: true
    }
    {
        invocation: "rip"
        execution: "rip {file}"
        leave_broot: true
        from_shell: true
    }
    {
        invocation: "copy_here"
        execution: "xcp {file} ."
        leave_broot: true
        from_shell: true
    }
    {
        invocation: "move_here"
        execution: "mv {file} ."
        leave_broot: true
        from_shell: true
    }
    {
        invocation: "copy_to_panel"
        execution: "xcp -r {file} {other-panel-directory}"
        from_shell: true
        # leave_broot: false
    }
    {
        invocation: "move_to_panel"
        execution: "mv {file} {other-panel-directory}"
        from_shell: true
        # leave_broot: false
    }
    {
        invocation: "git_home"
        execution: [
             "sh",
             "-c",
             "cd \"{git-root}\" && git remote get-url origin | sed 's#^git@\\(.*\\):#https://\\1/#;s#\\.git$##' | xargs xdg-open"
        ]
        leave_broot: true
    }
]
