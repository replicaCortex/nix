verbs: [
    {
        invocation: "ok"
        key: "enter"
        leave_broot: true
        execution: ":print_path"
        apply_to: "file"
    }
    {
        key: ctrl-u
        internal: ":input_clear"
    }
    {
        key: ctrl-h
        internal: ":input_del_char_left"
    }
    {
        key: ctrl-w
        internal: ":input_del_word_left"
    }
    {
        key: ctrl-k
        execution: ":line_up"
    }
    {
        key: ctrl-j
        execution: ":line_down"
    }
    {
        invocation: "ok"
        key: "enter"
        leave_broot: true
        execution: ":print_path"
        apply_to: "directory"
    }
    {
        invocation: "krita"
        execution: "niri msg action spawn-sh -- \"krita {file}\""
        leave_broot: true
        from_shell: true
    }
]
