# Sway Config — replicaCortex ✨

# 🧩 Includes & Defaults
# include /etc/sway/config.d/*
default_border pixel 2px
font Ubuntu Mono 14px

# ⌨️  Mod + Keybindings
set $mod Mod4
set $left h
set $left_ru р
set $down j
set $up k
set $right l
mouse_warping container

set $term footclient
# set $menu exec $term --app-id=launcher -e sway-launcher-desktop
set $histClip exec $term --app-id=cliphist -e bash -c "cliphist-fzf-sixel"
set $screen exec dunstify "󱠏  Screenshot" "Area selection" -t 1500 && grim -g "$(slurp)" - | wl-copy --type image/png
set $screenSave exec 'd=$(date +%s); dunstify "󱠏  Screenshot" "Area selection and save" -t 1500 && grim -g "$(slurp)" ~/"$(date +%s)".png && dunstify "󱠏  Screenshot" "file saved to ~/$d.png"'
set $zen_ exec $term --app-id=cliphist -e bash -c ~/nix/zen/sh.sh

# exec
# Ебать nixos хуйня )))
exec systemctl --user import-environment XDG_SESSION_TYPE XDG_CURRENT_DESKTOP 
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

exec waybar
exec dunst
exec wl-paste --watch cliphist store
exec foot --server
exec gammastep -O 4000
exec rm ly-session.log 

for_window [app_id="^cliphist$"] floating enable, sticky enable, move position 608 52
for_window [app_id="^pavucontrol$"] floating enable, sticky enable
# for_window [app_id="^mpv$"] floating enable, sticky enable
# for_window [app_id="blueman-manager"] floating enable, sticky enable

# 🖼️  Display & Wallpaper
output * bg ~/nix/wallpapers/girl-outline.png fill

# ⌨️ Input Devices
input "type:keyboard" {
    xkb_layout us,ru
    xkb_variant ,
    xkb_options grp:caps_toggle,shift:both_capslock
}

input "type:touchpad" {
  tap enabled
  # natural_scroll enabled
}

gaps inner 5
# gaps outer 1

# 🔧 Workspace Management
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# 🧠 Tiling & Layout
# bindsym --to-code $mod+b splith
bindsym --to-code $mod+v split toggle
bindsym --to-code $mod+s layout stacking
bindsym --to-code $mod+t layout tabbed
bindsym --to-code $mod+e layout toggle split
bindsym --to-code $mod+u fullscreen
bindsym --to-code $mod+i floating toggle
bindsym --to-code $mod+space focus mode_toggle
bindsym --to-code $mod+a focus parent

# 💻 Window Management
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec $term --working-directory="$(swaycwd)"
bindsym --to-code $mod+Shift+c kill
# bindsym --to-code $mod+d exec $menu
bindsym --to-code $mod+w exec $zen_
floating_modifier $mod normal
bindsym --to-code $mod+Shift+q reload

bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -b 'Yes, exit sway' 'swaymsg exit'

# 🎯 Focus Navigation
bindsym --to-code $mod+$left focus left
bindsym --to-code $mod+$down focus down
bindsym --to-code $mod+$up focus up
bindsym --to-code $mod+$right focus right
bindsym --to-code $mod+Left focus left
bindsym --to-code $mod+Down focus down
bindsym --to-code $mod+Up focus up
bindsym --to-code $mod+Right focus right

# 🔀 Move Windows
bindsym --to-code $mod+Shift+$left move left
bindsym --to-code $mod+Shift+$down move down
bindsym --to-code $mod+Shift+$up move up
bindsym --to-code $mod+Shift+$right move right
bindsym --to-code $mod+Shift+Left move left
bindsym --to-code $mod+Shift+Down move down
bindsym --to-code $mod+Shift+Up move up
bindsym --to-code $mod+Shift+Right move right

# 📦 Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# 🎧 Media & Brightness
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +2%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -2%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# ➕ Resize Mode
mode "resize" {
  bindsym $right resize shrink width 10px
  bindsym $down resize shrink height 10px
  bindsym $up resize grow height 10px
  bindsym $left resize grow width 10px
  bindsym Right resize shrink width 10kx
  bindsym Down resize grow height 10px
  bindsym Up resize shrink height 10px
  bindsym Left resize grow width 10px
  bindsym Return mode "default"
  bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

bindsym --to-code Ctrl+Shift+h $histClip
bindsym --to-code $mod+p $screen
bindsym --to-code $mod+Shift+p $screenSave
bindsym --to-code $mod+z exec zen ~/nix/zen/load.load


# 🎨 Theme & Appearance
# client.focused #FFA500 #FFA500 #282828 #FFA500
client.focused #FFA500 #FFA500 #282828 #FFf500

