set download-path=~/
set input-autohide=true
set spell-checking=true
set spell-checking-languages=en,ru
set incsearch=true
set default-font=Ubuntu mono
set monospace-font=Ubuntu mono
set sans-serif-font=Ubuntu mono
set serif-font=Ubuntu mono
set font-size=16
set monospace-font-size=16

set completion-css=color:#ebdbb2;background-color:#3c3836;font:12pt 'Ubuntu Mono';
set completion-hover-css=color: #ebdbb2;background-color:#504945;font:12pt 'Ubuntu Mono';
set completion-selected-css=color: #ebdbb2;background-color:#504945;font:12pt 'Ubuntu Mono';
set input-css=color:#ebdbb2;background-color:#282828;font:12pt 'Ubuntu Mono';
set input-error-css=color:#fb4934;background-color:#282828;font:12pt 'Ubuntu Mono';
set status-css=color:#fabd2f;background-color:#282828;font:12pt 'Ubuntu Mono';
set status-ssl-css=color:#b8bb26;background-color:#282828;font:12pt 'Ubuntu Mono';
set status-ssl-invalid-css=color: #fb4934;background-color:#282828;font:12pt 'Ubuntu Mono';
