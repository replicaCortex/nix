verbs: [
    {
        invocation: "ok"
        key: "enter"
        leave_broot: true
        execution: ":print_path"
        apply_to: "file"
    }
    {
        key: ctrl-u
        internal: ":input_clear"
    }
    {
        key: ctrl-h
        internal: ":input_del_char_left"
    }
    {
        key: ctrl-w
        internal: ":input_del_word_left"
    }
    {
        key: ctrl-p
        execution: ":line_up"
    }
    {
        key: ctrl-n
        execution: ":line_down"
    }
    {
        invocation: "ok"
        key: "enter"
        leave_broot: true
        execution: ":print_path"
        apply_to: "directory"
    }

    {
        invocation: figure
        execution: ":focus ~/.var/.minecraft/figura/avatars/"
    }

]
