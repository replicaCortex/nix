short_time := "15"
short_count := "30"
medium_time := "30"
medium_count := "20"
long_time := "120"
long_count := "10"
feh_flags := "--geometry 1919x1079 --scale-down --image-bg=#282828 --on-last-slide quit -Z -D"
sleep_time := "30"
alarm_time := "25"
c_reset := "\\033[0m"
c_green := "\\033[1;32m"
c_yellow := "\\033[1;33m"
c_cyan := "\\033[1;36m"

short:
    @just run {{ short_time }} {{ short_count }}

medium:
    @just run {{ medium_time }} {{ medium_count }}

long:
    @just run {{ long_time }} {{ long_count }}

review time="999":
    @echo -e "{{ c_cyan }}🔄 Reviewing last session...{{ c_reset }}"
    @(sleep 0.2 && niri msg action maximize-column) &
    @feh {{ feh_flags }} {{ time }} -f last_session.txt

run time count:
    @ls *.png | shuf -n {{ count }} > last_session.txt
    @echo "--- File Name $(date) ---" >> history.log
    @cat last_session.txt >> history.log
    @(sleep 0.2 && niri msg action maximize-column) &
    @feh {{ feh_flags }} {{ time }} -f last_session.txt

mirror_gen:
    @for f in *.png; do if [[ ! "$f" == *"_mirrored"* && ! -f "${f%.png}_mirrored.png" ]]; then magick "$f" -flop "${f%.png}_mirrored.png"; fi; done

session:
    @echo -e "{{ c_cyan }}🚀 Starting Daily Drawing Session...{{ c_reset }}"

    @just short
    @(sleep {{ alarm_time }} && echo -e "\n{{ c_yellow }}🔔 Get ready! medium starts in a few seconds...{{ c_reset }}") &
    @sleep {{ sleep_time }} 

    @echo -e "{{ c_cyan }}🔥 Moving to: Medium Set...{{ c_reset }}"
    @just medium
    @(sleep {{ alarm_time }} && echo -e "\n{{ c_yellow }}🔔 Attention! Deep long session is coming up...{{ c_reset }}") &
    @sleep {{ sleep_time }}

    @echo -e "{{ c_cyan }}🧠 Moving to: Anatomy long...{{ c_reset }}"
    @just long

    @echo -e "\n{{ c_green }}✨ CONGRATULATIONS! Training session complete.{{ c_reset }}"

