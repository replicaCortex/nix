{
  "layer": "top",
  "position": "top",
  "spacing": 6,
  "modules-left": [
    "sway/workspaces",
    "sway/language",
    "sway/mode"
  ],
  "modules-center": [
    "clock#time",
    "custom/separator",
    "clock#week",
    "custom/separator_dot",
    "clock#month",
    "custom/separator",
    "clock#calendar"
  ],
  "modules-right": [
    "tray", "network", "cpu", "memory", "disk", "temperature",
    "pulseaudio", "bluetooth", "battery"
  ],
  "sway/workspaces": {
    "format": " {name} ",
    "format-icons": {},
    "show-special": true
  },
  "sway/language": {
    "format": "{short}"
  },
  "sway/mode": {
      "format": "<span style=\"italic\">{}</span>"
  },
  "clock#time": {
    "format": "  {:%H:%M:%S}",
   "interval": 1
  },
  "custom/separator": {
    "format": " | ",
    "tooltip": false
  },
  "custom/separator_space": {
    "format": " ",
    "tooltip": false
  },
  "custom/separator_dot": {
    "format": "•",
    "tooltip": false
  },
  "clock#week": {
    "format": "{:%a}"
  },
  "clock#month": {
    "format": "{:%h}"
  },
  "clock#calendar": {
    "format": "{:%F}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "actions": {
      "on-click-right": "mode"
    },
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#f4dbd6'><b>{}</b></span>",
        "days": "<span color='#cad3f5'><b>{}</b></span>",
        "weeks": "<span color='#c6a0f6'><b>W{}</b></span>",
        "weekdays": "<span color='#a6da95'><b>{}</b></span>",
        "today": "<span color='#f38ba8'><b>{}</b></span>"
      }
    }
  },
  "bluetooth": {
    "states": {
      "high": 90,
      "upper-medium": 70,
      "medium": 50,
      "lower-medium": 30,
      "low": 10
    },
    "format": "",
    "format-disabled": "X",
    "format-connected-battery":"󰂅 {device_battery_percentage}%",
    "max-length": 35
  },
  "keyboard-state": {
    "capslock": true,
    "format": "{icon}",
    "format-icons": {
      "locked": "!",
      "unlocked": " "
    }
  },
  "cpu": {
    "format": " {usage}%",
    "states": {
      "high": 90,
      "upper-medium": 70,
      "medium": 50,
      "lower-medium": 30,
      "low": 10
    }
  },
  "memory": {
    "format": " {percentage}%",
    "states": {
      "high": 90,
      "upper-medium": 70,
      "medium": 50,
      "lower-medium": 30,
      "low": 10
    }
  },
  "disk": {
    "format": " {percentage_used}%",
    "states": {
      "high": 90,
      "upper-medium": 70,
      "medium": 50,
      "lower-medium": 30,
      "low": 10
    }
  },
  "temperature": {
    "hwmon-path": "/sys/class/drm/card1/device/hwmon/hwmon6/temp1_input",
    "critical-threshold": 70,
    "format": " {temperatureC}°C"
  },
  "battery": {
    "states": {
      "high": 90,
      "upper-medium": 70,
      "medium": 50,
      "lower-medium": 30,
      "low": 10
    },
    "format": "{icon} {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": [
      "[      ]",
      "[=     ]",
      "[==    ]",
      "[====  ]",
      "[===== ]",
      "[======]"
    ]
  },
  "pulseaudio": {
    "states": {
        "high": 90,
        "upper-medium": 70,
        "medium": 50,
        "lower-medium": 30,
        "low": 10
    },
    "scroll-step": 2,
    "format": "{icon} {volume}%",
    "format-bluetooth": " {icon} {volume}%",
    "format-bluetooth-muted": " {icon}  {format_source}",
    "format-muted": " {format_source}",
    "format-icons": {
      "car": "",
      "default": ["", "", ""],
      "headphone": "",
      "phone": "",
      "portable": ""
    }
  },
  "network": {
"interval": 2,
    "format-wifi": " {bandwidthTotalBytes}",
    "format-ethernet": "",
    "format-linked": "",
    "format-disconnected": "⚠"
  },
  "tray": {
    "show-passive-items": true,
    "spacing": 5
  }
}
