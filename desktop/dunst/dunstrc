[global]
    font = "Ubuntu Mono"
    allow_markup = yes
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = center
    bounce_freq = 0
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    geometry = "300x5"
    transparency = 0
    idle_threshold = 120
    monitor = 0
    follow = mouse
    sticky_history = yes
    line_height = 0
    origin = top-right
    offset = 5x4
    
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    frame_width = 2

    separator_color = "#504945" 

    startup_notification = false

[urgency_low]
    background = "#282828"
    foreground = "#a89984"
    frame_color = "#a89984"
    timeout = 5

[urgency_normal]
    background = "#282828"
    foreground = "#ebdbb2"
    frame_color = "#d79921"
    timeout = 10

[urgency_critical]
    background = "#cc241d"
    foreground = "#fbf1c7"
    frame_color = "#fb4934"
    timeout = 0
